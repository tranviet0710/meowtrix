# ===========================================
# MEOWTRIX Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Gemini AI Vision ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=meowtrix-search-protocol
# For Temporal Cloud, set an API key (preferred). Leave blank for local dev.
# When set, the worker connects with TLS + Bearer auth + `temporal-namespace` metadata.
TEMPORAL_API_KEY=
# Alternative to API key: mTLS client cert + key (PEM contents, not paths).
# TEMPORAL_TLS_CERT=
# TEMPORAL_TLS_KEY=

# --- Escalating Search Protocol tier overrides (optional, milliseconds) ---
# Leave commented to use defaults: 6h notify / 24h flyer / 48h expand / 14d conclude.
# Useful for demos where you want faster tiers.
# SEARCH_PROTOCOL_STAGE1_DELAY_MS=60000        # e.g. 1 minute to Stage 1 (nearby notify)
# SEARCH_PROTOCOL_STAGE2_DELAY_MS=300000       # e.g. 5 minutes more to Stage 2 (PDF flyer)
# SEARCH_PROTOCOL_STAGE3_DELAY_MS=900000       # e.g. 15 minutes more to Stage 3 (5km expand)
# SEARCH_PROTOCOL_STAGE4_DELAY_MS=1800000      # e.g. 30 minutes more to Stage 4 (conclude)
# SEARCH_PROTOCOL_STAGE1_RADIUS_M=1000
# SEARCH_PROTOCOL_STAGE3_RADIUS_M=5000

# --- Seed Data ---
SEED_DATA=false
SEED_CLEANUP=false

# --- Resend (Email) ---
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- App URL (for email links) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
